

# --- MySQL ---------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Puerto de MySQL. Lo usan tanto el mapeo de puertos del contenedor
# como la API para conectarse: déjalo en 3306 salvo que sepas lo que haces.
MYSQL_PORT=3306
# Solo para ejecutar la API fuera de Docker (en Docker se usa "db")
# MYSQL_HOST=localhost

# --- Seguridad -----------------------------------------
# Pepper global para el hash de contraseñas (R25)
PEPPER=
# Clave para firmar los JWT (mínimo 32 caracteres)
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Clave AES-256 en Base64 para cifrar datos sensibles (R23)
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY=

# --- Ajustes de la aplicación --------------------------
# Ruta del archivo INI (opcional, por defecto config/settings.ini)
# SETTINGS_FILE_PATH=config/settings.ini